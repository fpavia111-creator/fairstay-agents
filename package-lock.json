        "node": ">=20"
      }
    },
    "packages/remedy-core": {
      "version": "0.2.0",
      "license": "MIT",
      "bin": {
        "remedy-approve": "bin/remedy-approve.js",
        "remedy-license": "bin/remedy-license.js",
        "remedy-new-agent": "bin/remedy-new-agent.js",
        "remedy-verify-log": "bin/remedy-verify-log.js"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
