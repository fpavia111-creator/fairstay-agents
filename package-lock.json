{
  "name": "evergreen-agents",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "evergreen-agents",
      "license": "MIT",
      "workspaces": [
        "packages/remedy-core",
        "packages/evergreen-core",
        "packages/*"
