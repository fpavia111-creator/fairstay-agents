{
 "suite": "willow-of-managed-care",
 "root": "..",
 "data_note": "Fictional plans, rates and residents in ../fixtures. Deterministic checks; no model is called.",
 "cases": [
  {
   "id": "totals",
   "tool": "willow_check",
   "args": {
    "claims": "fixtures/claims.csv",
    "rates": "fixtures/contract-rates.csv",
    "auths": "fixtures/auths.csv"
   },
   "expect": {
    "status": "executed",
    "equals": {
     "result.claims": 7,
     "result.claims_with_findings": 6,
     "result.underpaid": 1550,
     "result.billed_short": 675,
     "result.at_risk_without_auth": 5460
    }
   }
  },
  {
   "id": "auth-problems-first",
   "tool": "willow_check",
   "args": {
    "claims": "fixtures/claims.csv",
    "rates": "fixtures/contract-rates.csv",
    "auths": "fixtures/auths.csv"
   },
   "expect": {
    "equals": {
     "result.items.0.status": "no_auth_number",
     "result.items.0.claim_id": "M7005",
     "result.items.1.status": "auth_not_found",
     "result.items.1.claim_id": "M7006"
    }
   }
  },
  {
   "id": "days-outside-auth",
   "tool": "willow_check",
   "args": {
    "claims": "fixtures/claims.csv",
    "rates": "fixtures/contract-rates.csv",
    "auths": "fixtures/auths.csv",
    "status": "days_beyond_auth"
   },
   "expect": {
    "equals": {
     "result.items.0.days_outside": 6,
     "result.items.0.auth_to": "2026-03-14",
     "result.items.0.amount": 3660
    }
   }
  },
  {
   "id": "level-not-authorized",
   "tool": "willow_check",
   "args": {
    "claims": "fixtures/claims.csv",
    "rates": "fixtures/contract-rates.csv",
    "auths": "fixtures/auths.csv",
    "status": "level_not_authorized"
   },
   "expect": {
    "equals": {
     "result.items.0.auth_level": "L2",
     "result.items.0.amount": 1800
    }
   }
  },
  {
   "id": "underpaid",
   "tool": "willow_check",
   "args": {
    "claims": "fixtures/claims.csv",
    "rates": "fixtures/contract-rates.csv",
    "auths": "fixtures/auths.csv",
    "status": "paid_below_contract"
   },
   "expect": {
    "equals": {
     "result.items.0.claim_id": "M7002",
     "result.items.0.contract_amount": 18910
    }
   }
  },
  {
   "id": "billed-below",
   "tool": "willow_check",
   "args": {
    "claims": "fixtures/claims.csv",
    "rates": "fixtures/contract-rates.csv",
    "auths": "fixtures/auths.csv",
    "status": "billed_below_contract"
   },
   "expect": {
    "equals": {
     "result.items.0.contract_amount": 11475
    }
   }
  },
  {
   "id": "unknown-level",
   "tool": "willow_check",
   "args": {
    "claims": "fixtures/claims.csv",
    "rates": "fixtures/contract-rates.csv",
    "auths": "fixtures/auths.csv",
    "status": "no_contract_rate"
   },
   "expect": {
    "equals": {
     "result.items.0.level": "RB9"
    }
   }
  },
  {
   "id": "limit-one",
   "tool": "willow_check",
   "args": {
    "claims": "fixtures/claims.csv",
    "rates": "fixtures/contract-rates.csv",
    "auths": "fixtures/auths.csv",
    "limit": 1
   },
   "expect": {
    "equals": {
     "result.items_truncated": 6
    }
   }
  },
  {
   "id": "names-masked",
   "tool": "willow_check",
   "args": {
    "claims": "fixtures/claims.csv",
    "rates": "fixtures/contract-rates.csv",
    "auths": "fixtures/auths.csv"
   },
   "expect": {
    "not_contains": [
     "Prescott",
     "R706"
    ]
   }
  },
  {
   "id": "missing-rates-file",
   "tool": "willow_check",
   "args": {
    "claims": "fixtures/claims.csv",
    "rates": "fixtures/nope.csv",
    "auths": "fixtures/auths.csv"
   },
   "expect": {
    "status": "error"
   }
  },
  {
   "id": "report",
   "tool": "willow_write_report",
   "args": {
    "claims": "fixtures/claims.csv",
    "rates": "fixtures/contract-rates.csv",
    "auths": "fixtures/auths.csv",
    "out_dir": "evergreen-out/eval-willow"
   },
   "expect": {
    "status": "executed"
   }
  },
  {
   "id": "claim-submit-refused",
   "tool": "claim_submit",
   "args": {},
   "expect": {
    "status": "blocked",
    "decision": "block"
   }
  },
  {
   "id": "portal-refused",
   "tool": "payer_portal_login",
   "args": {},
   "expect": {
    "status": "blocked",
    "decision": "block"
   }
  },
  {
   "id": "recall-empty-memory",
   "tool": "willow_recall",
   "args": {},
   "expect": {
    "status": "executed",
    "contains": [
     "memory is empty",
     "level_alias"
    ]
   }
  }
 ]
}