{
 "suite": "beech-of-propco",
 "root": "..",
 "data_note": "Fictional leases and operators in ../fixtures. Deterministic checks; no model is called.",
 "cases": [
  {
   "id": "totals",
   "tool": "beech_check",
   "args": {
    "leases": "fixtures/leases.csv",
    "rent": "fixtures/rent-roll.csv",
    "financials": "fixtures/operator-financials.csv",
    "rules": "fixtures/rules.json",
    "as_of": "2026-04-20"
   },
   "expect": {
    "status": "executed",
    "equals": {
     "result.leases": 3,
     "result.rent_billed": 1838969.24,
     "result.rent_collected": 1699511.46
    }
   }
  },
  {
   "id": "unpaid-first",
   "tool": "beech_check",
   "args": {
    "leases": "fixtures/leases.csv",
    "rent": "fixtures/rent-roll.csv",
    "financials": "fixtures/operator-financials.csv",
    "rules": "fixtures/rules.json",
    "as_of": "2026-04-20"
   },
   "expect": {
    "equals": {
     "result.items.0.status": "rent_unpaid",
     "result.items.0.period": "2026-04",
     "result.items.0.days_late": 15
    }
   }
  },
  {
   "id": "short",
   "tool": "beech_check",
   "args": {
    "leases": "fixtures/leases.csv",
    "rent": "fixtures/rent-roll.csv",
    "financials": "fixtures/operator-financials.csv",
    "rules": "fixtures/rules.json",
    "as_of": "2026-04-20",
    "status": "rent_short"
   },
   "expect": {
    "equals": {
     "result.items.0.amount": 24728.89
    }
   }
  },
  {
   "id": "escalator",
   "tool": "beech_check",
   "args": {
    "leases": "fixtures/leases.csv",
    "rent": "fixtures/rent-roll.csv",
    "financials": "fixtures/operator-financials.csv",
    "rules": "fixtures/rules.json",
    "as_of": "2026-04-20",
    "status": "escalator_not_billed"
   },
   "expect": {
    "equals": {
     "result.items.0.expected": 199224.77,
     "result.items.0.amount": 4859.15
    }
   }
  },
  {
   "id": "coverage",
   "tool": "beech_check",
   "args": {
    "leases": "fixtures/leases.csv",
    "rent": "fixtures/rent-roll.csv",
    "financials": "fixtures/operator-financials.csv",
    "rules": "fixtures/rules.json",
    "as_of": "2026-04-20",
    "status": "coverage_below"
   },
   "expect": {
    "equals": {
     "result.items.0.coverage": 1.02,
     "result.items.0.months": 12
    }
   }
  },
  {
   "id": "financials-missing",
   "tool": "beech_check",
   "args": {
    "leases": "fixtures/leases.csv",
    "rent": "fixtures/rent-roll.csv",
    "financials": "fixtures/operator-financials.csv",
    "rules": "fixtures/rules.json",
    "as_of": "2026-04-20",
    "status": "financials_missing"
   },
   "expect": {
    "equals": {
     "result.items.0.months_missing.0": "2026-02"
    }
   }
  },
  {
   "id": "lease-ending",
   "tool": "beech_check",
   "args": {
    "leases": "fixtures/leases.csv",
    "rent": "fixtures/rent-roll.csv",
    "financials": "fixtures/operator-financials.csv",
    "rules": "fixtures/rules.json",
    "as_of": "2026-04-20",
    "status": "lease_ending"
   },
   "expect": {
    "equals": {
     "result.items.0.days_left": 255
    }
   }
  },
  {
   "id": "no-financials-file",
   "tool": "beech_check",
   "args": {
    "leases": "fixtures/leases.csv",
    "rent": "fixtures/rent-roll.csv",
    "as_of": "2026-04-20"
   },
   "expect": {
    "not_contains": [
     "coverage_below",
     "occupancy_below"
    ]
   }
  },
  {
   "id": "typo-rules-refused",
   "tool": "beech_check",
   "args": {
    "leases": "fixtures/leases.csv",
    "rent": "fixtures/rent-roll.csv",
    "financials": "fixtures/operator-financials.csv",
    "rules": "fixtures/rules-typo.json",
    "as_of": "2026-04-20"
   },
   "expect": {
    "status": "error",
    "contains": [
     "ending_days"
    ]
   }
  },
  {
   "id": "lease-numbers-masked",
   "tool": "beech_check",
   "args": {
    "leases": "fixtures/leases.csv",
    "rent": "fixtures/rent-roll.csv",
    "financials": "fixtures/operator-financials.csv",
    "rules": "fixtures/rules.json",
    "as_of": "2026-04-20"
   },
   "expect": {
    "not_contains": [
     "L-40021",
     "L-40022"
    ],
    "matches": [
     "ACCT-[0-9a-f]{8}"
    ]
   }
  },
  {
   "id": "report",
   "tool": "beech_write_report",
   "args": {
    "leases": "fixtures/leases.csv",
    "rent": "fixtures/rent-roll.csv",
    "financials": "fixtures/operator-financials.csv",
    "rules": "fixtures/rules.json",
    "as_of": "2026-04-20"
   },
   "expect": {
    "status": "executed",
    "contains": [
     "beech-propco.csv"
    ]
   }
  },
  {
   "id": "notice-refused",
   "tool": "default_notice_send",
   "args": {},
   "expect": {
    "status": "blocked",
    "decision": "block"
   }
  },
  {
   "id": "recall-empty",
   "tool": "beech_recall",
   "args": {},
   "expect": {
    "status": "executed",
    "contains": [
     "memory is empty",
     "lease_note"
    ]
   }
  }
 ]
}