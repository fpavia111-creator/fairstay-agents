{
 "suite": "acacia-of-accruals",
 "root": "..",
 "no_names_in_report": true,
 "data_note": "Fictional employees and payroll in ../fixtures. Deterministic arithmetic; no model is called.",
 "cases": [
  {
   "id": "totals",
   "tool": "acacia_check",
   "args": {
    "register": "fixtures/register.csv",
    "pto": "fixtures/pto-2026-03-31.csv",
    "booked": "fixtures/booked.csv",
    "rules": "fixtures/rules.json",
    "month": "2026-03"
   },
   "expect": {
    "status": "executed",
    "equals": {
     "result.wage_accrual": 8061.55,
     "result.pto_liability": 5745.62,
     "result.booked_wages": 6730,
     "result.booked_pto": 5160
    }
   }
  },
  {
   "id": "nursing-under",
   "tool": "acacia_check",
   "args": {
    "register": "fixtures/register.csv",
    "pto": "fixtures/pto-2026-03-31.csv",
    "booked": "fixtures/booked.csv",
    "rules": "fixtures/rules.json",
    "month": "2026-03"
   },
   "expect": {
    "equals": {
     "result.items.0.status": "under_accrued",
     "result.items.0.department": "Nursing",
     "result.items.0.amount": 1278
    }
   }
  },
  {
   "id": "split-period",
   "tool": "acacia_check",
   "args": {
    "register": "fixtures/register.csv",
    "pto": "fixtures/pto-2026-03-31.csv",
    "booked": "fixtures/booked.csv",
    "rules": "fixtures/rules.json",
    "month": "2026-03"
   },
   "expect": {
    "equals": {
     "result.departments.2.wages": 6800,
     "result.departments.0.wages": 330
    }
   }
  },
  {
   "id": "pto",
   "tool": "acacia_check",
   "args": {
    "register": "fixtures/register.csv",
    "pto": "fixtures/pto-2026-03-31.csv",
    "booked": "fixtures/booked.csv",
    "rules": "fixtures/rules.json",
    "month": "2026-03",
    "status": "pto_under_accrued"
   },
   "expect": {
    "equals": {
     "result.items.0.department": "Housekeeping",
     "result.items.0.calculated": 1519
    }
   }
  },
  {
   "id": "journal-balances",
   "tool": "acacia_check",
   "args": {
    "register": "fixtures/register.csv",
    "pto": "fixtures/pto-2026-03-31.csv",
    "booked": "fixtures/booked.csv",
    "rules": "fixtures/rules.json",
    "month": "2026-03"
   },
   "expect": {
    "equals": {
     "result.journal.0.debit": 1278,
     "result.journal.1.credit": 1278,
     "result.journal.length": 4
    }
   }
  },
  {
   "id": "small-differences-left",
   "tool": "acacia_check",
   "args": {
    "register": "fixtures/register.csv",
    "pto": "fixtures/pto-2026-03-31.csv",
    "booked": "fixtures/booked.csv",
    "rules": "fixtures/rules.json",
    "month": "2026-03"
   },
   "expect": {
    "not_contains": [
     "Dietary: wages"
    ]
   }
  },
  {
   "id": "pto-without-taxes",
   "tool": "acacia_check",
   "args": {
    "register": "fixtures/register.csv",
    "pto": "fixtures/pto-2026-03-31.csv",
    "booked": "fixtures/booked.csv",
    "rules": "fixtures/rules-pto-untaxed.json",
    "month": "2026-03"
   },
   "expect": {
    "equals": {
     "result.pto_liability": 5295.5
    }
   }
  },
  {
   "id": "bad-month",
   "tool": "acacia_check",
   "args": {
    "register": "fixtures/register.csv",
    "pto": "fixtures/pto-2026-03-31.csv",
    "booked": "fixtures/booked.csv",
    "rules": "fixtures/rules.json",
    "month": "March"
   },
   "expect": {
    "status": "error",
    "contains": [
     "month"
    ]
   }
  },
  {
   "id": "typo-rules-refused",
   "tool": "acacia_check",
   "args": {
    "register": "fixtures/register.csv",
    "pto": "fixtures/pto-2026-03-31.csv",
    "booked": "fixtures/booked.csv",
    "rules": "fixtures/rules-typo.json",
    "month": "2026-03"
   },
   "expect": {
    "status": "error",
    "contains": [
     "tax_pct"
    ]
   }
  },
  {
   "id": "employees-masked",
   "tool": "acacia_check",
   "args": {
    "register": "fixtures/register.csv",
    "pto": "fixtures/pto-2026-03-31.csv",
    "booked": "fixtures/booked.csv",
    "rules": "fixtures/rules.json",
    "month": "2026-03"
   },
   "expect": {
    "not_contains": [
     "Nia Brooks",
     "E201"
    ]
   }
  },
  {
   "id": "report",
   "tool": "acacia_write_report",
   "args": {
    "register": "fixtures/register.csv",
    "pto": "fixtures/pto-2026-03-31.csv",
    "booked": "fixtures/booked.csv",
    "rules": "fixtures/rules.json",
    "month": "2026-03"
   },
   "expect": {
    "status": "executed",
    "contains": [
     "acacia-accruals.csv"
    ]
   }
  },
  {
   "id": "post-refused",
   "tool": "journal_post",
   "args": {},
   "expect": {
    "status": "blocked",
    "decision": "block"
   }
  },
  {
   "id": "recall-empty",
   "tool": "acacia_recall",
   "args": {},
   "expect": {
    "status": "executed",
    "contains": [
     "memory is empty",
     "accrual_note"
    ]
   }
  }
 ]
}