{
  "suite": "fairstay-borrowing-base",
  "root": "..",
  "data_note": "Fictional residents and example loan terms in ../fixtures. Deterministic arithmetic; no model is called.",
  "cases": [
    {
      "id": "certificate",
      "tool": "borrowing_check",
      "args": {
        "ar": "fixtures/ar-aging.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-03-31"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.gross_ar": 397700,
          "result.ineligible": 71625,
          "result.eligible": 326075,
          "result.borrowing_base": 270870,
          "result.available": 30870
        }
      }
    },
    {
      "id": "ineligibles-by-reason",
      "tool": "borrowing_check",
      "args": {
        "ar": "fixtures/ar-aging.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-03-31"
      },
      "expect": {
        "equals": {
          "result.ineligibles.over_age": 17400,
          "result.ineligibles.medicaid_pending": 33000,
          "result.ineligibles.cross_aged": 6200,
          "result.ineligibles.credit_balance": 1300,
          "result.ineligibles.concentration_excess": 13725
        }
      }
    },
    {
      "id": "concentration-first",
      "tool": "borrowing_check",
      "args": {
        "ar": "fixtures/ar-aging.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-03-31"
      },
      "expect": {
        "equals": {
          "result.items.0.status": "concentration_excess",
          "result.items.0.amount": 13725
        }
      }
    },
    {
      "id": "cross-aged-private",
      "tool": "borrowing_check",
      "args": {
        "ar": "fixtures/ar-aging.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-03-31",
        "status": "cross_aged"
      },
      "expect": {
        "equals": {
          "result.items.0.payer_type": "private",
          "result.items.0.amount": 6200
        }
      }
    },
    {
      "id": "private-advance-rate",
      "tool": "borrowing_check",
      "args": {
        "ar": "fixtures/ar-aging.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-03-31"
      },
      "expect": {
        "equals": {
          "result.by_payer_type.4.payer_type": "private",
          "result.by_payer_type.4.eligible": 5800,
          "result.by_payer_type.4.availability": 2900
        }
      }
    },
    {
      "id": "default-terms",
      "tool": "borrowing_check",
      "args": {
        "ar": "fixtures/ar-aging.csv",
        "as_of": "2026-03-31"
      },
      "expect": {
        "equals": {
          "result.borrowing_base": 270870,
          "result.line_limit": null,
          "result.available": 270870
        }
      }
    },
    {
      "id": "over-line",
      "tool": "borrowing_check",
      "args": {
        "ar": "fixtures/ar-aging.csv",
        "terms": "fixtures/terms-overdrawn.json",
        "as_of": "2026-03-31"
      },
      "expect": {
        "equals": {
          "result.items.0.status": "over_line",
          "result.items.0.amount": 19130
        }
      }
    },
    {
      "id": "typo-terms-refused",
      "tool": "borrowing_check",
      "args": {
        "ar": "fixtures/ar-aging.csv",
        "terms": "fixtures/rules-typo.json",
        "as_of": "2026-03-31"
      },
      "expect": {
        "status": "error",
        "contains": [
          "advance_rate"
        ]
      }
    },
    {
      "id": "masked",
      "tool": "borrowing_check",
      "args": {
        "ar": "fixtures/ar-aging.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-03-31"
      },
      "expect": {
        "not_contains": [
          "Wade Corliss",
          "R1609"
        ],
        "matches": [
          "MRN-[0-9a-f]{8}"
        ]
      }
    },
    {
      "id": "report",
      "tool": "borrowing_write_report",
      "args": {
        "ar": "fixtures/ar-aging.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-03-31"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "borrowing-base.csv"
        ]
      }
    },
    {
      "id": "submit-refused",
      "tool": "certificate_submit",
      "args": {},
      "expect": {
        "status": "blocked",
        "decision": "block"
      }
    },
    {
      "id": "draw-refused",
      "tool": "line_draw",
      "args": {},
      "expect": {
        "status": "blocked",
        "decision": "block"
      }
    },
    {
      "id": "recall-empty",
      "tool": "borrowing_recall",
      "args": {},
      "expect": {
        "status": "executed",
        "contains": [
          "memory is empty",
          "lender_note"
        ]
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "borrowing_check",
      "args": {
        "ar": "../../outside-root.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-03-31"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside the allowed root"
        ]
      }
    },
    {
      "id": "missing-file-named",
      "tool": "borrowing_check",
      "args": {
        "ar": "fixtures/missing-export.csv",
        "terms": "fixtures/terms.json",
        "as_of": "2026-03-31"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
