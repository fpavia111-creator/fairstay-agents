{
  "name": "fairstay-payer-source",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairstay-payer-source",
  "description": "Payer source for every resident day: days with no payer, two payers on the same day, payers missing from your payer list, Medicare Part A past day 100, coinsurance days with no secondary payer, hospice residents on the wrong payer and private pay with no responsible party.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairstay-payer-source": "bin/fairstay-payer-source.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairstay-payer-source.js demo",
    "eval": "node bin/fairstay-payer-source.js eval"
  },
  "dependencies": {
    "fairstay-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairstay-agents.git",
    "directory": "packages/fairstay-payer-source"
  },
  "homepage": "https://github.com/fpavia111-creator/fairstay-agents/tree/main/packages/fairstay-payer-source#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairstay-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "nursing-home",
    "skilled-nursing",
    "snf",
    "long-term-care",
    "evergreen",
    "payer-source",
    "census",
    "coinsurance"
  ]
}
