{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/fairstay-staffing-and-pbj",
  "title": "Fairstay Staffing and PBJ",
  "description": "Staffing and PBJ checks: hours per resident day by role against your targets, days without 8…",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/fairstay-agents",
    "source": "github",
    "subfolder": "packages/fairstay-staffing-and-pbj"
  },
  "websiteUrl": "https://fair-agents.com/fairstay.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "fairstay-staffing-and-pbj",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
