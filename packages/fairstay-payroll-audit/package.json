{
  "name": "fairstay-payroll-audit",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairstay-payroll-audit",
  "description": "Payroll audit for nursing homes: missing punches, paid hours that differ from punches, overtime under the 40-hour or 8/80 rule, shift differentials left out of the overtime rate, garnishments over the limit and terminated staff paid.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairstay-payroll-audit": "bin/fairstay-payroll-audit.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairstay-payroll-audit.js demo",
    "eval": "node bin/fairstay-payroll-audit.js eval"
  },
  "dependencies": {
    "fairstay-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairstay-agents.git",
    "directory": "packages/fairstay-payroll-audit"
  },
  "homepage": "https://github.com/fpavia111-creator/fairstay-agents/tree/main/packages/fairstay-payroll-audit#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairstay-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "nursing-home",
    "skilled-nursing",
    "snf",
    "long-term-care",
    "evergreen",
    "payroll",
    "overtime",
    "garnishment",
    "flsa"
  ]
}
