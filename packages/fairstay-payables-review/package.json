    "eval": "node bin/fairstay-payables-review.js eval"
  },
  "dependencies": {
    "fairstay-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairstay-agents.git",
    "directory": "packages/fairstay-payables-review"
  },
  "homepage": "https://github.com/fpavia111-creator/fairstay-agents/tree/main/packages/fairstay-payables-review#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairstay-agents/issues"
  },
  "keywords": [
    "mcp",
