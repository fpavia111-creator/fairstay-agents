{
  "suite": "fairstay-census-billing",
  "root": "..",
  "data_note": "Fictional home, residents and payers in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "census_check",
      "args": {
        "census": "fixtures/census-2026-02.csv",
        "billing": "fixtures/billing-2026-02.csv",
        "rates": "fixtures/rates.json",
        "month": "2026-02"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.residents": 9,
          "result.census_days": 254,
          "result.billable_days": 240,
          "result.billed_days": 258,
          "result.revenue_at_risk": 13738,
          "result.overbilled": 7593.5
        }
      }
    },
    {
      "id": "every-planted-status-in-order",
      "tool": "census_check",
      "args": {
        "census": "fixtures/census-2026-02.csv",
        "billing": "fixtures/billing-2026-02.csv",
        "rates": "fixtures/rates.json",
        "month": "2026-02"
      },
      "expect": {
        "equals": {
          "result.items.0.status": "wrong_payer",
          "result.items.1.status": "unbilled",
          "result.items.2.status": "billed_not_in_census",
          "result.items.3.status": "bed_hold_billed",
          "result.items.4.status": "duplicate_billed",
          "result.items.5.status": "census_overlap",
          "result.items.6.status": "level_mismatch",
          "result.items.7.status": "rate_mismatch"
        }
      }
    },
    {
      "id": "wrong-payer-days",
      "tool": "census_check",
      "args": {
        "census": "fixtures/census-2026-02.csv",
        "billing": "fixtures/billing-2026-02.csv",
        "rates": "fixtures/rates.json",
        "month": "2026-02",
        "status": "wrong_payer"
      },
      "expect": {
        "equals": {
          "result.items.0.days": 14,
          "result.items.0.from": "2026-02-01",
          "result.items.0.to": "2026-02-14",
          "result.items.0.amount": 9100
        },
        "contains": [
          "the days were billed to Lone Star Medicaid"
        ]
      }
    },
    {
      "id": "unbilled-tail-of-month",
      "tool": "census_check",
      "args": {
        "census": "fixtures/census-2026-02.csv",
        "billing": "fixtures/billing-2026-02.csv",
        "rates": "fixtures/rates.json",
        "month": "2026-02",
        "status": "unbilled"
      },
      "expect": {
        "equals": {
          "result.items.0.days": 8,
          "result.items.0.amount": 1964
        }
      }
    },
    {
      "id": "after-discharge",
      "tool": "census_check",
      "args": {
        "census": "fixtures/census-2026-02.csv",
        "billing": "fixtures/billing-2026-02.csv",
        "rates": "fixtures/rates.json",
        "month": "2026-02",
        "status": "billed_not_in_census"
      },
      "expect": {
        "equals": {
          "result.items.0.from": "2026-02-20",
          "result.items.0.days": 9
        },
        "contains": [
          "after the resident's last census day"
        ]
      }
    },
    {
      "id": "hospital-leave-not-on-bed-hold-list",
      "tool": "census_check",
      "args": {
        "census": "fixtures/census-2026-02.csv",
        "billing": "fixtures/billing-2026-02.csv",
        "rates": "fixtures/rates.json",
        "month": "2026-02",
        "status": "bed_hold_billed"
      },
      "expect": {
        "equals": {
          "result.items.0.days": 3,
          "result.items.0.to": "2026-02-12"
        }
      }
    },
    {
      "id": "without-rates-no-dollars-and-no-rate-check",
      "tool": "census_check",
      "args": {
        "census": "fixtures/census-2026-02.csv",
        "billing": "fixtures/billing-2026-02.csv",
        "month": "2026-02"
      },
      "expect": {
        "equals": {
          "result.revenue_at_risk": 0
        },
        "not_contains": [
          "rate_mismatch"
        ]
      }
    },
    {
      "id": "start-end-period",
      "tool": "census_check",
      "args": {
        "census": "fixtures/census-2026-02.csv",
        "billing": "fixtures/billing-2026-02.csv",
        "rates": "fixtures/rates.json",
        "start": "2026-02-01",
        "end": "2026-02-14"
      },
      "expect": {
        "equals": {
          "result.census_days": 126,
          "result.by_status.wrong_payer": 1
        },
        "not_contains": [
          "\"unbilled\""
        ]
      }
    },
    {
      "id": "names-masked",
      "tool": "census_check",
      "args": {
        "census": "fixtures/census-2026-02.csv",
        "billing": "fixtures/billing-2026-02.csv",
        "rates": "fixtures/rates.json",
        "month": "2026-02"
      },
      "expect": {
        "matches": [
          "\"resident_id\":\"MRN-[0-9a-f]{8}\""
        ],
        "not_contains": [
          "Okafor",
          "R103"
        ]
      }
    },
    {
      "id": "bad-rates-file-refused",
      "tool": "census_check",
      "args": {
        "census": "fixtures/census-2026-02.csv",
        "billing": "fixtures/billing-2026-02.csv",
        "rates": "fixtures/rates-typo.json",
        "month": "2026-02"
      },
      "expect": {
        "status": "error",
        "contains": [
          "rates"
        ]
      }
    },
    {
      "id": "report-in-spanish",
      "tool": "census_write_report",
      "args": {
        "census": "fixtures/census-2026-02.csv",
        "billing": "fixtures/billing-2026-02.csv",
        "rates": "fixtures/rates.json",
        "month": "2026-02",
        "language": "es",
        "out_dir": "evergreen-out/eval-census"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.lang": "es"
        }
      }
    },
    {
      "id": "claim-submit-refused",
      "tool": "claim_submit",
      "args": {},
      "expect": {
        "status": "blocked",
        "decision": "block"
      }
    },
    {
      "id": "census-update-refused",
      "tool": "census_update",
      "args": {},
      "expect": {
        "status": "blocked",
        "decision": "block"
      }
    },
    {
      "id": "recall-empty-memory",
      "tool": "census_recall",
      "args": {},
      "expect": {
        "status": "executed",
        "contains": [
          "memory is empty",
          "bed_hold_payer"
        ]
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "census_check",
      "args": {
        "census": "../../outside-root.csv",
        "billing": "fixtures/billing-2026-02.csv",
        "rates": "fixtures/rates.json",
        "month": "2026-02"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside the allowed root"
        ]
      }
    },
    {
      "id": "missing-file-named",
      "tool": "census_check",
      "args": {
        "census": "fixtures/missing-export.csv",
        "billing": "fixtures/billing-2026-02.csv",
        "rates": "fixtures/rates.json",
        "month": "2026-02"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
