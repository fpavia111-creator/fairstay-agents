{
  "suite": "yew-of-length-of-stay",
  "root": "..",
  "data_note": "Fictional residents and example settings in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "yew_check",
      "args": {
        "census": "fixtures/census.csv",
        "stays": "fixtures/stays.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-17"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.skilled_residents": 6,
          "result.by_status.nomnc_late": 1,
          "result.by_status.nomnc_due": 1
        }
      }
    },
    {
      "id": "nomnc-late-first",
      "tool": "yew_check",
      "args": {
        "census": "fixtures/census.csv",
        "stays": "fixtures/stays.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-17"
      },
      "expect": {
        "equals": {
          "result.items.0.status": "nomnc_late",
          "result.items.0.nomnc_due": "2026-03-16",
          "result.items.0.last_covered_day": "2026-03-18"
        }
      }
    },
    {
      "id": "nomnc-due",
      "tool": "yew_check",
      "args": {
        "census": "fixtures/census.csv",
        "stays": "fixtures/stays.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-17",
        "status": "nomnc_due"
      },
      "expect": {
        "equals": {
          "result.items.0.nomnc_due": "2026-03-19",
          "result.items.0.days_left": 2
        }
      }
    },
    {
      "id": "nomnc-given-in-time",
      "tool": "yew_check",
      "args": {
        "census": "fixtures/census.csv",
        "stays": "fixtures/stays-nomnc-given.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-17"
      },
      "expect": {
        "not_contains": [
          "nomnc_late",
          "nomnc_due"
        ]
      }
    },
    {
      "id": "custodial",
      "tool": "yew_check",
      "args": {
        "census": "fixtures/census.csv",
        "stays": "fixtures/stays.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-17",
        "status": "custodial_on_skilled"
      },
      "expect": {
        "equals": {
          "result.items.0.payer_type": "managed_care"
        }
      }
    },
    {
      "id": "discharge-past-due",
      "tool": "yew_check",
      "args": {
        "census": "fixtures/census.csv",
        "stays": "fixtures/stays.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-17",
        "status": "discharge_past_due"
      },
      "expect": {
        "equals": {
          "result.items.0.planned_discharge": "2026-03-12"
        }
      }
    },
    {
      "id": "day-20",
      "tool": "yew_check",
      "args": {
        "census": "fixtures/census.csv",
        "stays": "fixtures/stays.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-17",
        "status": "day_20_coming"
      },
      "expect": {
        "equals": {
          "result.items.0.benefit_day": 17,
          "result.items.0.days_left": 3
        }
      }
    },
    {
      "id": "day-100",
      "tool": "yew_check",
      "args": {
        "census": "fixtures/census.csv",
        "stays": "fixtures/stays.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-17",
        "status": "day_100_coming"
      },
      "expect": {
        "equals": {
          "result.items.0.benefit_day": 88,
          "result.items.0.days_left": 12
        }
      }
    },
    {
      "id": "auth-ending",
      "tool": "yew_check",
      "args": {
        "census": "fixtures/census.csv",
        "stays": "fixtures/stays.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-17",
        "status": "auth_ending_no_plan"
      },
      "expect": {
        "equals": {
          "result.items.0.auth_end": "2026-03-19"
        }
      }
    },
    {
      "id": "typo-rules-refused",
      "tool": "yew_check",
      "args": {
        "census": "fixtures/census.csv",
        "stays": "fixtures/stays.csv",
        "rules": "fixtures/rules-typo.json",
        "as_of": "2026-03-17"
      },
      "expect": {
        "status": "error",
        "contains": [
          "review_every"
        ]
      }
    },
    {
      "id": "masked",
      "tool": "yew_check",
      "args": {
        "census": "fixtures/census.csv",
        "stays": "fixtures/stays.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-17"
      },
      "expect": {
        "not_contains": [
          "Bea Lindholm",
          "R1401"
        ],
        "matches": [
          "MRN-[0-9a-f]{8}"
        ]
      }
    },
    {
      "id": "report",
      "tool": "yew_write_report",
      "args": {
        "census": "fixtures/census.csv",
        "stays": "fixtures/stays.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-17"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "yew-weekly-meeting.csv"
        ]
      }
    },
    {
      "id": "notice-refused",
      "tool": "notice_deliver",
      "args": {},
      "expect": {
        "status": "blocked",
        "decision": "block"
      }
    },
    {
      "id": "recall-empty",
      "tool": "yew_recall",
      "args": {},
      "expect": {
        "status": "executed",
        "contains": [
          "memory is empty",
          "meeting_note"
        ]
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "yew_check",
      "args": {
        "census": "../../outside-root.csv",
        "stays": "fixtures/stays.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-17"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside the allowed root"
        ]
      }
    },
    {
      "id": "missing-file-named",
      "tool": "yew_check",
      "args": {
        "census": "fixtures/missing-export.csv",
        "stays": "fixtures/stays.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-17"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
