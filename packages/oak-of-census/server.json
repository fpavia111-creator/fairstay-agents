{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/oak-of-census",
  "title": "Oak of Census",
  "description": "Census against billing for nursing homes",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/evergreen-agents",
    "source": "github",
    "subfolder": "packages/oak-of-census"
  },
  "websiteUrl": "https://fair-agents.com/fairstay.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "oak-of-census",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
