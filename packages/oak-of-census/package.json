{
  "name": "oak-of-census",
  "version": "0.1.0",
  "description": "Census against billing for nursing homes: days billed to the wrong payer, unbilled or over-billed days, leave days billed to a payer that does not pay bed holds, days after discharge, overlapping census rows and per-diem rates that differ from your rate table.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "oak-of-census": "bin/oak-of-census.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/oak-of-census.js demo",
    "eval": "node bin/oak-of-census.js eval"
  },
  "dependencies": {
    "evergreen-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/evergreen-agents.git",
    "directory": "packages/oak-of-census"
  },
  "homepage": "https://github.com/fpavia111-creator/evergreen-agents/tree/main/packages/oak-of-census#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/evergreen-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "nursing-home",
    "skilled-nursing",
    "snf",
    "long-term-care",
    "evergreen",
    "census",
    "per-diem",
    "bed-hold"
  ]
}
