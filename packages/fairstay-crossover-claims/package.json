{
  "name": "fairstay-crossover-claims",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairstay-crossover-claims",
  "description": "Medicare-to-Medicaid crossovers for dual-eligible residents: Medicare coinsurance never crossed over, crossovers billed for the wrong amount, zero-paid crossovers to check against the state's lesser-of rule, and unpaid coinsurance to keep for the bad debt log.",
