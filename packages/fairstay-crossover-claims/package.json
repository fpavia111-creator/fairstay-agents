  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairstay-crossover-claims": "bin/fairstay-crossover-claims.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairstay-crossover-claims.js demo",
    "eval": "node bin/fairstay-crossover-claims.js eval"
  },
  "dependencies": {
    "fairstay-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairstay-agents.git",
    "directory": "packages/fairstay-crossover-claims"
  },
  "homepage": "https://github.com/fpavia111-creator/fairstay-agents/tree/master/packages/fairstay-crossover-claims#readme",
  "bugs": {
