{
  "suite": "maple-of-medicaid-pending",
  "root": "..",
  "data_note": "Fictional home, residents and state numbers in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "maple_check",
      "args": {
        "applications": "fixtures/applications.csv",
        "census": "fixtures/census.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-03"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.applications": 7,
          "result.open": 3,
          "result.oldest_days": 92,
          "result.pending_balance": 35680,
          "result.pending_balance_by_age.91-120": 21450
        }
      }
    },
    {
      "id": "order",
      "tool": "maple_check",
      "args": {
        "applications": "fixtures/applications.csv",
        "census": "fixtures/census.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-03"
      },
      "expect": {
        "equals": {
          "result.items.0.status": "not_applied",
          "result.items.1.status": "appeal_window_closing",
          "result.items.2.status": "appeal_window_closed",
          "result.items.3.status": "docs_overdue",
          "result.items.4.status": "decision_overdue"
        }
      }
    },
    {
      "id": "appeal-deadline",
      "tool": "maple_check",
      "args": {
        "applications": "fixtures/applications.csv",
        "census": "fixtures/census.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-03",
        "status": "appeal_window_closing"
      },
      "expect": {
        "equals": {
          "result.items.0.appeal_deadline": "2026-03-14",
          "result.items.0.days_left": 11
        }
      }
    },
    {
      "id": "outstanding-docs-only",
      "tool": "maple_check",
      "args": {
        "applications": "fixtures/applications.csv",
        "census": "fixtures/census.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-03",
        "status": "docs_overdue"
      },
      "expect": {
        "equals": {
          "result.items.0.docs_outstanding.0": "Life insurance policy",
          "result.items.0.docs_outstanding.1": "Deed"
        }
      }
    },
    {
      "id": "approved-not-billed",
      "tool": "maple_check",
      "args": {
        "applications": "fixtures/applications.csv",
        "census": "fixtures/census.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-03",
        "status": "approved_not_billed"
      },
      "expect": {
        "equals": {
          "result.items.0.effective_date": "2025-11-01"
        },
        "contains": [
          "not billed yet"
        ]
      }
    },
    {
      "id": "longer-decision-time-clears-overdue",
      "tool": "maple_check",
      "args": {
        "applications": "fixtures/applications.csv",
        "as_of": "2026-03-03",
        "rules": "fixtures/rules-120.json"
      },
      "expect": {
        "not_contains": [
          "decision_overdue"
        ]
      }
    },
    {
      "id": "without-census-no-not-applied",
      "tool": "maple_check",
      "args": {
        "applications": "fixtures/applications.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-03"
      },
      "expect": {
        "not_contains": [
          "not_applied"
        ]
      }
    },
    {
      "id": "later-date-more-overdue",
      "tool": "maple_check",
      "args": {
        "applications": "fixtures/applications.csv",
        "census": "fixtures/census.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-20"
      },
      "expect": {
        "equals": {
          "result.by_status.appeal_window_closed": 2
        }
      }
    },
    {
      "id": "names-masked",
      "tool": "maple_check",
      "args": {
        "applications": "fixtures/applications.csv",
        "census": "fixtures/census.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-03"
      },
      "expect": {
        "matches": [
          "\"resident_id\":\"MRN-[0-9a-f]{8}\""
        ],
        "not_contains": [
          "Quill",
          "R508"
        ]
      }
    },
    {
      "id": "bad-rules-refused",
      "tool": "maple_check",
      "args": {
        "applications": "fixtures/applications.csv",
        "census": "fixtures/census.csv",
        "rules": "fixtures/rules-typo.json",
        "as_of": "2026-03-03"
      },
      "expect": {
        "status": "error",
        "contains": [
          "appeal"
        ]
      }
    },
    {
      "id": "report",
      "tool": "maple_write_report",
      "args": {
        "applications": "fixtures/applications.csv",
        "census": "fixtures/census.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-03",
        "out_dir": "evergreen-out/eval-maple",
        "language": "de"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.lang": "de"
        }
      }
    },
    {
      "id": "submit-refused",
      "tool": "medicaid_application_submit",
      "args": {},
      "expect": {
        "status": "blocked",
        "decision": "block"
      }
    },
    {
      "id": "email-refused",
      "tool": "email_send",
      "args": {},
      "expect": {
        "status": "blocked",
        "decision": "block"
      }
    },
    {
      "id": "recall-empty-memory",
      "tool": "maple_recall",
      "args": {},
      "expect": {
        "status": "executed",
        "contains": [
          "memory is empty",
          "caseworker_note"
        ]
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "maple_check",
      "args": {
        "applications": "../../outside-root.csv",
        "census": "fixtures/census.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-03"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside the allowed root"
        ]
      }
    },
    {
      "id": "missing-file-named",
      "tool": "maple_check",
      "args": {
        "applications": "fixtures/missing-export.csv",
        "census": "fixtures/census.csv",
        "rules": "fixtures/rules.json",
        "as_of": "2026-03-03"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
